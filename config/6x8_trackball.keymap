#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include "boards/shields/6x8_trackball/6x8_trackball.dts"

//| SW7  | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |          | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  | SW7  | SW8  |         
//| SW14 | SW13 | SW12 | SW11 | SW10 | SW9  | SW8  |          | SW9  | SW10 | SW11 | SW12 | SW13 | SW14 | SW15 | SW16 | 
//| SW22 | SW21 | SW20 | SW19 | SW18 | SW17 | SW16 | SW15 |   | SW17 | SW18 | SW19 | SW20 | SW21 | SW22 | SW23 | SW24 |         
//| SW30 | SW29 | SW28 | SW27 | SW26 | SW25 | SW24 | SW23 |   | SW25 | SW26 | SW27 | SW28 | SW29 | SW30 | SW31 | SW32 |         
//| SW37 | SW36 | SW35 | SW34 | SW33 | SW32 | SW31 |                 | SW33 | SW34 | SW35 | SW36 | SW37 | SW38 | SW39 |         
//                     | SW39 | SW38 |                                             | SW40 | SW41 |        
//                                    | SW42 | SW41 | SW40 |         | SW42 |      | SW43 |
//                                           | SW44 | SW43 |             | SW44 | SW45 |

/ {
    behaviors {
        td0: colemak_dh_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "colemak_dh_layer";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&tog 1>;
        };
        td1: esc_grave {
            compatible = "zmk,behavior-tap-dance";
            label = "grave_esc_tap";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp GRAVE>;
        };
};

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |            |  ESC  | F7   |  F8   |  F9   | F10   |  F11  |  F12  | RET  |
// |  mac1 |  grv  |  1  |  2  |  3   |  4   |  5   |            |       |  6   |  7    |  8    |  9    |   0   |   -   |   +  |
// |  mac2 |  TAB  |  Q  |  W  |  E   |  R   |  T   |   {   |    |   }   |  Y   |  U    |  I    |  O    |   P   |   [   |   ]  |
// |  mac3 |  CTRL |  A  |  S  |  D   |  F   |  G   |   [   |    |   ]   |  H   |  J    |  K    |  L    |   ;   |   @   |   #  |
// |   |   | SHIFT |  Z  |  X  |  C   |  V   |  B   |                    |  N   |  M    |  ,    |  .    |   /   | SHIFT | RCTRL|
//                       | ALT | GUI  |                                                 | LAY2  | LAY3  | 
//                                    | SPACE | LOWER | LAY1 |           | LAY1 |       |  LAY1 |
//                                            | SPACE | RAISE|               | BSPC  |  BKSP |
//                                       

            bindings = <
&kp ESC              &kp F1    &kp F2 &kp F3   &kp F4   &kp F5    &kp F6             &kp ESC    &kp F7  &kp F8   &kp F9    &kp F10   &kp F11  &kp F12   &kp RET
&kp A                &kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5             &kp Y      &kp N6  &kp N7   &kp N8    &kp N9    &kp N0   &kp MINUS &kp EQUAL
&kp B                &kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T     &kp P    &kp W      &kp Y   &kp U    &kp I     &kp O     &kp P    &kp LBKT  &kp RBKT
&kp C                &kp LCTRL &kp A  &kp S    &kp D    &kp F     &kp G     &kp RBKT &kp RBKT   &kp H   &kp J    &kp K     &kp L     &kp SEMI &kp SQT   &kp NUHS
&kp NON_US_BACKSLASH &kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B                         &kp N   &kp M    &kp COMMA &kp DOT   &kp FSLH &kp RSHFT &kp RCTRL
                                      &kp LALT &kp LGUI                                                          &kp RET   &kp RGUI
                                                        &kp SPACE &kp W     &kp R               &kp N1           &kp N2
                                                                  &kp SPACE &kp Y                   &kp BSPC  &kp N4
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        colmak_dh {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |            |  ESC  | F7   |  F8   |  F9   | F10   |  F11  |  F12  | RET  |
// |  mac1 |  grv  |  1  |  2  |  3   |  4   |  5   |            |       |  6   |  7    |  8    |  9    |   0   |   -   |   +  |
// |  mac2 |  TAB  |  Q  |  W  |  F   |  P   |  B   |   {   |    |   }   |  L   |  L    |  U    |  Y    |   :   |   [   |   ]  |
// |  mac3 |  CTRL |  A  |  R  |  S   |  T   |  G   |   [   |    |   ]   |  M   |  N    |  E    |  I    |   O   |   @   |   #  |
// |   |   | SHIFT |  Z  |  X  |  C   |  D   |  V   |                    |  K   |  H    |  ,    |  .    |   /   | SHIFT | RCTRL|
//                       | ALT | GUI  |                                                 | LAY2  | LAY3  | 
//                                    | SPACE | LOWER | LAY1 |           | LAY1 |       |  LAY1 |
//                                            | SPACE | RAISE|               | BSPC  |  BKSP |
//                                       

            bindings = <
&trans               &trans    &trans &trans   &trans   &trans    &trans             &trans     &trans  &trans   &trans    &trans    &trans   &trans    &trans
&trans               &trans    &trans &trans   &trans   &trans    &trans             &trans     &trans  &trans   &trans    &trans    &trans   &trans    &trans
&trans               &trans    &kp Q  &kp W    &kp F    &kp P     &kp B     &trans   &trans     &kp J   &kp L    &kp U     &kp Y     &kp SEMI &trans    &trans
&trans               &trans    &kp A  &kp R    &kp S    &kp T     &kp G     &trans   &trans     &kp M   &kp N    &kp E     &kp I     &kp O    &trans    &trans
&trans               &trans    &kp Z  &kp X    &kp C    &kp D     &kp V                         &kp K   &kp H    &trans    &trans    &trans   &trans    &trans
                                      &trans   &trans                                                            &trans    &trans
                                                        &trans    &trans    &trans              &trans           &trans
                                                                  &trans    &trans                  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_1 {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |            |  ESC  | F7   |  F8   |  F9   | F10   |  F11  |  F12  | RET  |
// |  mac1 |  grv  |  1  |  2  |  3   |  4   |  5   |            |       |  6   |  7    |  8    |  9    |   0   |   -   |   +  |
// |  mac2 |  TAB  |  Q  |  W  |  F   |  P   |  B   |   {   |    |   }   |  L   |  L    |  U    |  Y    |   :   |   [   |   ]  |
// |  mac3 |  CTRL |  A  |  R  |  S   |  T   |  G   |   [   |    |   ]   | HOME |  <    |  ^    |  v    |   >   |  END  |   #  |
// |   |   | SHIFT |  Z  |  X  |  C   |  D   |  V   |                    |  K   |  H    |  ,    |  .    |   /   | SHIFT | RCTRL|
//                       | ALT | GUI  |                                                 | LAY2  | LAY3  | 
//                                    | SPACE | LOWER | LAY1 |           | LAY1 |       |  LAY1 |
//                                            | RET   | RAISE|               | BSPC  |  BKSP |
//                                       

            bindings = <
&trans               &trans    &trans &trans   &trans   &trans    &trans             &trans     &trans    &trans   &trans    &trans    &trans    &trans    &trans
&trans               &trans    &trans &trans   &trans   &trans    &trans             &trans     &trans    &trans   &trans    &trans    &trans    &trans    &trans
&trans               &trans    &trans &trans   &trans   &trans    &trans    &trans   &trans     &trans    &trans   &trans    &trans    &trans    &trans    &trans
&trans               &trans    &trans &trans   &trans   &trans    &trans    &trans   &trans     &kp HOME  &kp LEFT &kp UP    &kp DOWN  &kp RIGHT &kp END   &trans
&trans               &trans    &trans &trans   &trans   &kp DEL   &trans                        &trans    &trans   &trans    &trans    &trans    &trans    &trans
                                      &trans   &trans                                                              &trans    &trans
                                                        &trans    &trans    &trans              &trans             &trans
                                                                  &kp RET   &trans                  &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

};
